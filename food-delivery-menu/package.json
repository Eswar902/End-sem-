{
  "name": "food-delivery-menu",
  "version": "1.0.0",
  "private": true,
  "description": "Food delivery menu application powered by JSON Server",
  "scripts": {
    "server": "json-server --watch db.json --port 3000",
    "start": "vite --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run start\""
  },
  "dependencies": {
    "json-server": "^0.17.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.4.14"
  }
}